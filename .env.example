# AI-Bibliometrics — environment contract (Phase 0). Placeholders only; never commit real secrets.
# Copy to `.env` and fill in:  copy .env.example .env  (Windows) / cp .env.example .env (Linux)

# Live PostgreSQL (9 canonical Silver tables). Runtime uses the app_readonly role (docs/08 §1.1).
#
# TWO NON-OBVIOUS REQUIREMENTS, both learned the hard way:
#
# 1. On Supabase's TRANSACTION pooler the tenant is derived from the username, so
#    a custom role must be <user>.<project-ref>. A bare `app_readonly` fails with
#    `no tenant identifier provided (external_id or sni_hostname required)`.
#      postgresql://app_readonly.<project-ref>:PW@aws-0-<region>.pooler.supabase.com:5432/postgres
#
# 2. The password must be URL-safe (RFC 3986 unreserved: A-Z a-z 0-9 - _ . ~) or
#    percent-encoded. A raw `@`, `:`, `#` or `/` in the password produces a DSN
#    that looks right and fails to parse.
#
# 3. app_readonly needs an RLS policy to see anything at all. RLS is enabled on
#    every corpus table, and RLS with no policy default-denies any role that is
#    not the table owner. Migration 008 creates `FOR SELECT ... TO app_readonly`;
#    without it this role authenticates successfully and reads zero rows.
DB_URL=postgresql://app_readonly.CHANGE_ME_PROJECT_REF:CHANGE_ME@HOST:5432/DBNAME

# Owner-role URL for DDL and for the offline admin scripts
# (scripts/grant_readonly.py, scripts/grant_session_role.py, scripts/verify_schema.py).
#
# KEEP THIS UNCOMMENTED. `scripts/db.get_db_connection()` prefers DB_URL_OWNER and
# falls back to DB_URL. Without it, admin scripts silently connect as the runtime
# read-only role and fail the first time they need to GRANT anything — which reads
# like a permissions bug rather than a missing variable.
# DB_URL_OWNER=postgresql://postgres.CHANGE_ME_PROJECT_REF:CHANGE_ME@HOST:5432/DBNAME

# Ollama. Compose does NOT run an ollama service — the model server is your own
# native Ollama install on the host, so the backend reaches it over the Docker
# host gateway. Override here only if your host Ollama listens elsewhere.
OLLAMA_HOST=http://host.docker.internal:11434

# Locked model identifiers (docs/09)
LLM_MODEL=qwen2.5-coder:7b-instruct
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSION=1024

# VectorRoute cosine-similarity gate (docs/05 §5.2, FR4.5).
# 0.48 is the benchmark-selected default: it is the measured ceiling of every
# strict-absence negative query in tests/fixtures/retrieval_benchmark_v1.json,
# so it admits real evidence without admitting a false positive. The previous
# default 0.65 answered not_found for 59.5% of answerable queries because
# bge-m3 scores natural-language questions in the 0.42-0.57 band.
# PROTOTYPE-CALIBRATED on a 20-publication corpus - re-validate with
#   python scripts/bench_retrieval.py
# after production-scale ingestion. This value moves the Zero-Hallucination
# invariant's operating point, so change it deliberately.
VECTOR_COSINE_THRESHOLD=0.48

# Distinct publications VectorRoute returns per query (FR4.4). Applied AFTER
# the cosine gate and AFTER per-publication dedup, so it bounds evidence volume
# rather than the ANN search window.
VECTOR_TOP_K=8

# Browser origins allowed by CORS (docs/08). Comma-separated.
# Default when unset: the four local dev origins below.
#   CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000
#
# WHEN THE FRONTEND IS DEPLOYED you must set this explicitly — a wildcard is NOT
# a valid substitute, because the API is credentialed (allow_credentials=True).
# Include the exact deploy origins, e.g.:
#   CORS_ORIGINS=https://your-app.vercel.app,https://app.yourdomain.id
# A value that parses to zero entries fails fast at startup rather than silently
# serving a localhost-only allow-list that blocks every real browser request.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000

# Per-IP request budget for /api/v1/ask (docs/08 §3). Default 60.
RATE_LIMIT_RPM=60

# ---------------------------------------------------------------------------
# Session persistence (application domain, docs/04 section 13)
# ---------------------------------------------------------------------------
# Conversation state lives in a SEPARATE PostgreSQL schema (`app`) under a
# SEPARATE role (`app_session`). It is deliberately NOT the same credential as
# DB_URL: the retrieval pool must stay read-only against the bibliometric
# corpus, and one connection able to both query `publications` and rewrite them
# would collapse the Session Isolation Invariant (docs/03 section 0.3 #5).
#
# LEAVING THIS UNSET IS A VALID, SUPPORTED STATE -- session persistence is
# opt-in. With it unset:
#   * GET/POST/DELETE /api/v1/sessions   -> 503 session_store_unavailable
#   * POST /api/v1/ask with a session_id  -> 503 session_store_unavailable
#   * POST /api/v1/ask without one        -> unchanged, fully stateless
# An explicit 503 is used rather than silently dropping the caller's session_id,
# because a silent 200 would look like the feature working.
#
# To enable (owner steps, in order):
#   python scripts/migrate.py up                  # creates schema `app` (migration 005)
#   python scripts/grant_session_role.py          # creates role app_session + grants
#   ALTER ROLE app_session LOGIN PASSWORD '...'   # credentials are yours to set
#   # then set DB_URL_SESSION below, and verify via GET /api/v1/health
#
# !! NEVER point DB_URL_SESSION at the same role as DB_URL. That would defeat
# !! the entire isolation model.
# DB_URL_SESSION=postgresql://app_session:CHANGE_ME@HOST:5432/DBNAME

# Schema holding conversation state. Must be a plain SQL identifier and is
# REJECTED at startup if set to `public` (or a system schema) -- session tables
# must not live beside the bibliometric corpus. Default: app
# SESSION_SCHEMA=app

# N in "session summary + N recent messages + current question". Bounds the
# conversation context so a long session cannot grow the LLM prompt without
# limit. Default 10.
# SESSION_RECENT_MESSAGES_LIMIT=10

# Hard cap on the rendered session summary (characters). Default 1200.
# SESSION_SUMMARY_MAX_CHARS=1200

# statement_timeout for the session pool, in ms. Shorter than the retrieval
# pool's 10s on purpose: session writes are single-row point updates, so
# anything slower is contention rather than work. Default 5000.
# SESSION_STATEMENT_TIMEOUT_MS=5000

# Consumed by docker-compose.yml, NOT by the app: it becomes uvicorn's
# --forwarded-allow-ips so X-Forwarded-For is honoured only from your proxy.
#
# !! NEVER set this to `*`. uvicorn would then trust a client-supplied
# X-Forwarded-For, letting anyone bypass rate limiting by inventing a new IP on
# every request. List only the real proxy IP/CIDR.
#
# 127.0.0.1 (the default below) is correct while nothing proxies the app. Once
# Caddy or a tunnel fronts the backend, set this to that proxy's address —
# otherwise every request shares one bucket and the site 429s globally.
TRUSTED_PROXY_IPS=127.0.0.1

# pgvector extension schema (Phase 4 audit M1): Supabase layout uses
# `extensions`; vanilla local installs use `public`. Must be a plain SQL
# identifier; anything else fails fast at startup (Settings validation).
VECTOR_SCHEMA=extensions

# Timeouts (docs/08 §1.2)
DB_STATEMENT_TIMEOUT_MS=10000
OLLAMA_TIMEOUT_S=8

# Extra attempts after the first for OUTBOUND Ollama calls (0 = single
# attempt). Total outbound attempts = 1 + this value. Default 1.
#
# !! A TIMEOUT IS NEVER RETRIED regardless of this value. The retry only covers
# transient CONNECT errors. Retrying a timeout means paying the identical
# timeout twice for a result that cannot arrive faster the second time — that
# is what used to block POST /api/v1/ask for ~17 s (8 s + backoff + 8 s) on an
# unsupported SQL question.
OLLAMA_MAX_RETRIES=1

# Per-attempt timeout for the Ollama Text-to-SQL fallback on the synchronous
# /api/v1/ask path. Deliberately shorter than OLLAMA_TIMEOUT_S: Text-to-SQL is
# the only LLM call a request can be blocked on without opting in via
# llm_synthesis. Default 6.
TEXT2SQL_TIMEOUT_S=6

# Narrative synthesis budget (docs/05 §7). Separate from OLLAMA_TIMEOUT_S because
# the work is completely different, and sized from MEASUREMENT rather than
# estimate. On the CPU-only reference deployment qwen2.5-coder:7b (4.36 GB):
#
#   generation  5.7-7.3 tok/s      prompt eval  ~70 tok/s
#   MODEL LOAD 69 s               real synthesis prompt  1359 tokens
#   warm call  22 s               cold call  91 s
#
# The budget is dominated by whether the model is RESIDENT, not by generation.
# Ollama's default 5-minute keep_alive evicts it between requests, so in practice
# every call is cold. 120 s covers the cold path; the previous 8 s could not emit
# a single token, and intermediate 60 s and 90 s budgets also failed 100% of the
# time for exactly this reason.
#
# To make synthesis ~22 s instead of ~91 s, raise Ollama's KEEP_ALIVE so the model
# stays resident. That is a server-side setting, not an application one.
#
# Cost warning: one synthesis call can occupy a CPU for 22-91 s. llm_synthesis
# defaults to false precisely so this is opt-in.
SYNTHESIS_TIMEOUT_S=120
SYNTHESIS_NUM_PREDICT=128

# pgvector HNSW search breadth, applied once per pooled connection.
# !! At the prototype corpus size (40 chunks) the planner chooses Seq Scan + Sort
# and never touches the HNSW index, so this has no effect on any observed plan.
# It is set per connection (not per request) because the per-request form cost
# 29-54 ms per query for nothing. Raise at the DATABASE level
# (ALTER DATABASE ... SET hnsw.ef_search) when the corpus grows past the point
# where the planner switches to Index Scan; RESET ALL reverts this between
# checkouts, so it is not a maintained per-request override.
HNSW_EF_SEARCH=100

# When Text-to-SQL times out, /api/v1/ask returns HTTP 504 with error_type
# "llm_timeout" — deliberately distinct from 422 "sql_generation_failed" (the
# question cannot be safely expressed as SQL) and 503 "db_timeout" (the
# database's statement_timeout fired). The frontend keys its timeout UI state
# off this code; do not collapse them.
