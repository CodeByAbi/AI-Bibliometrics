# AI-Bibliometrics — environment contract (Phase 0). Placeholders only; never commit real secrets.
# Copy to `.env` and fill in:  copy .env.example .env  (Windows) / cp .env.example .env (Linux)

# Live PostgreSQL (9 canonical Silver tables). Runtime uses the app_readonly role (docs/08 §1.1).
DB_URL=postgresql://app_readonly:CHANGE_ME@HOST:5432/DBNAME

# Owner-role URL for Fase 1+ DDL (CREATE EXTENSION vector, ALTER chunks, edge/Gold tables).
# Required from Task 1 onward; NOT used by Phase 0 (SELECT-only).
# DB_URL_OWNER=postgresql://owner:CHANGE_ME@HOST:5432/DBNAME

# Ollama (local, CPU). Compose service name `ollama`; override only for non-compose runs.
OLLAMA_HOST=http://ollama:11434

# Locked model identifiers (docs/09)
LLM_MODEL=qwen2.5-coder:7b-instruct
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSION=1024

# Browser origins allowed by CORS (docs/08). Comma-separated.
# Default when unset: the four local dev origins below.
#   CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000
#
# WHEN THE FRONTEND IS DEPLOYED you must set this explicitly — a wildcard is NOT
# a valid substitute, because the API is credentialed (allow_credentials=True).
# Include the exact deploy origins, e.g.:
#   CORS_ORIGINS=https://your-app.vercel.app,https://app.yourdomain.id
# A value that parses to zero entries fails fast at startup rather than silently
# serving a localhost-only allow-list that blocks every real browser request.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000

# Per-IP request budget for /api/v1/ask (docs/08 §3). Default 60.
RATE_LIMIT_RPM=60

# Consumed by docker-compose.yml, NOT by the app: it becomes uvicorn's
# --forwarded-allow-ips so X-Forwarded-For is honoured only from your proxy.
#
# !! NEVER set this to `*`. uvicorn would then trust a client-supplied
# X-Forwarded-For, letting anyone bypass rate limiting by inventing a new IP on
# every request. List only the real proxy IP/CIDR.
#
# 127.0.0.1 (the default below) is correct while nothing proxies the app. Once
# Caddy or a tunnel fronts the backend, set this to that proxy's address —
# otherwise every request shares one bucket and the site 429s globally.
TRUSTED_PROXY_IPS=127.0.0.1

# pgvector extension schema (Phase 4 audit M1): Supabase layout uses
# `extensions`; vanilla local installs use `public`. Must be a plain SQL
# identifier; anything else fails fast at startup (Settings validation).
VECTOR_SCHEMA=extensions

# Timeouts (docs/08 §1.2)
DB_STATEMENT_TIMEOUT_MS=10000
OLLAMA_TIMEOUT_S=8
